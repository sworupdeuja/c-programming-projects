#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main(){
    int quantity = 3;
    char product[3][100];
    float price[3];
    float total = 0;

    for (int i = 0; i < quantity; i++){
        printf("Enter the product:   ");
        fgets(product[i], sizeof(product[i]), stdin);
        product[i][strcspn(product[i], "\n")] = '\0';

        printf("Enter the price of the product:  ");
        scanf("%f", &price[i]);
        getchar();
    }

    for (int i = 0; i < quantity; i++){
        printf("%s = $%.2f\n", product[i], price[i]);
        total = total + price[i];
    }

    printf("Total amount: $%.2f\n", total);

    return 0;
}
