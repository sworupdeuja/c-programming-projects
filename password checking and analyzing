#include <stdio.h>
#include <string.h>
#include <ctype.h>

void password_input(char password[100]) {
    printf("Enter the password: ");
    fgets(password, 100, stdin);
    password[strcspn(password, "\n")] = '\0';
}

void login_input(char login[100]) {
    printf("Enter the login ID: ");
    fgets(login, 100, stdin);
    login[strcspn(login, "\n")] = '\0';
}

int main(void) {
    char password[100];
    char login[100];

    int uppercase = 0;
    int lowercase = 0;
    int digits = 0;
    int special = 0;
    int length;

    login_input(login);
    password_input(password);

    length = strlen(password);

    for (int i = 0; i < length; i++) {

        if (isupper(password[i])) {
            uppercase++;
        }
        else if (islower(password[i])) {
            lowercase++;
        }
        else if (isdigit(password[i])) {
            digits++;
        }
        else if (ispunct(password[i])) {
            special++;
        }
    }

    printf("\n--- Password Analysis ---\n");
    printf("Uppercase letters: %d\n", uppercase);
    printf("Lowercase letters: %d\n", lowercase);
    printf("Digits: %d\n", digits);
    printf("Special characters: %d\n", special);
    printf("Length: %d\n", length);

    if (length >= 12 && uppercase > 0 &&
        lowercase > 0 && digits > 0 && special > 0) {

        printf("Strong password\n");
    }
    else {
        printf("Weak password\n");

        if (length < 12)
            printf("- Use at least 12 characters.\n");

        if (uppercase == 0)
            printf("- Add an uppercase letter.\n");

        if (lowercase == 0)
            printf("- Add a lowercase letter.\n");

        if (digits == 0)
            printf("- Add a digit.\n");

        if (special == 0)
            printf("- Add a special character.\n");
    }

    return 0;
}
