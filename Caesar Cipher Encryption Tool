#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

int main(int argc, char *argv[])
{
    int key;
    key = atoi(argv[1]);

    printf("Key: %d\n", key);

    char letter[100];

    printf("Enter the letter: ");
    fgets(letter, sizeof(letter), stdin);

    letter[strcspn(letter, "\n")] = '\0';

    for (int i = 0; i < strlen(letter); i++)
    {
        if (isalpha(letter[i]))
        {
            if (islower(letter[i]))
            {
                printf("%c", 'a' + (letter[i] - 'a' + key) % 26);
            }
            else if (isupper(letter[i]))
            {
                printf("%c", 'A' + (letter[i] - 'A' + key) % 26);
            }
        }
        else
        {
            printf("%c", letter[i]);
        }
    }

    printf("\n");

    return 0;
}
